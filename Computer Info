# ============================
# SELF-RELAUNCH AS ADMIN + BYPASS
# ============================
$isAdmin = ([Security.Principal.WindowsPrincipal] `
    [Security.Principal.WindowsIdentity]::GetCurrent() `
    ).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)

$isBypass = ($env:EXECUTION_BYPASS -eq "1")

if (-not $isAdmin -or -not $isBypass) {
    Write-Host "Relaunching with Admin rights and Bypass policy..." -ForegroundColor Yellow

    $env:EXECUTION_BYPASS = "1"

    Start-Process powershell.exe -Verb RunAs -ArgumentList `
        "-ExecutionPolicy Bypass -NonInteractive -File `"$PSCommandPath`""

    exit
}

# ============================
# SET EXECUTION POLICY PERMANENTLY
# ============================
Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope LocalMachine -Force

# ============================
# SETTINGS
# ============================
$CompName    = $env:COMPUTERNAME
$UserName    = $env:USERNAME
$NetworkPath = "\\192.168.1.23\info pc"
$LogDir      = "$NetworkPath\logs"
$LogPath     = "$LogDir\$CompName.log"
$installer   = "\\192.168.1.23\Prog\epskit_x64.exe"
$xmlfile     = "\\192.168.1.23\Prog\installer.xml"

# ============================
# LOGGING FUNCTION
# ============================
function Write-Log($msg, $color = "White") {
    $line = "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') | $msg"
    try { Add-Content $LogPath $line -ErrorAction SilentlyContinue } catch {}
    Write-Host $line -ForegroundColor $color
}

# ============================
# NETWORK SHARE CHECK
# ============================
Write-Host "Checking network share..." -ForegroundColor Cyan

if (-not (Test-Path $NetworkPath)) {
    Write-Host "ERROR: Cannot reach network share: $NetworkPath" -ForegroundColor Red
    exit 1
}

# Create log dir if missing
if (!(Test-Path $LogDir)) {
    New-Item -ItemType Directory -Path $LogDir | Out-Null
}

Write-Log "===== START: $CompName =====" "Cyan"
Write-Log "Network share OK" "Green"

# ============================
# WINRM CONFIGURATION
# ============================
Write-Log "Configuring WinRM..." "Cyan"

try {
    Stop-Service WinRM -Force -ErrorAction SilentlyContinue
    Set-Service WinRM -StartupType Automatic
    Start-Service WinRM
    winrm quickconfig -q | Out-Null

    if (-not (Get-NetFirewallRule -DisplayName "WinRM Manual" -ErrorAction SilentlyContinue)) {
        New-NetFirewallRule `
            -DisplayName "WinRM Manual" `
            -Direction Inbound `
            -Protocol TCP `
            -LocalPort 5985 `
            -Action Allow `
            -Profile Domain, Private | Out-Null
        Write-Log "Firewall rule created" "Green"
    } else {
        Write-Log "Firewall rule already exists" "Yellow"
    }

    Write-Log "WinRM Ready" "Green"
}
catch {
    Write-Log "WinRM setup failed: $_" "Red"
}

# ============================
# BITDEFENDER INSTALLATION
# ============================
Write-Log "Starting Bitdefender installation..." "Cyan"

if (Test-Path $installer) {

    Write-Log "Installer path found. Running..." "Green"

    $cmd = "`"$installer`" -runInstaller -installerXml `"$xmlfile`" -v"
    $process = Start-Process "cmd.exe" -ArgumentList "/c $cmd" -PassThru

    Write-Log "Waiting for installer to finish..." "Yellow"
    $process.WaitForExit()
    Write-Log "Installer process finished (ExitCode: $($process.ExitCode))" "Green"

} else {
    Write-Log "ERROR: Cannot reach installer path: $installer" "Red"
}

# ============================
# SYSTEM INFO COLLECTION
# ============================
Write-Log "Collecting system data..." "Cyan"

$OS   = Get-CimInstance Win32_OperatingSystem
$CPU  = (Get-CimInstance Win32_Processor).Name
$BIOS = Get-CimInstance Win32_BIOS

$Report = @()

function Add-Row($Section, $Key, $Value) {
    $script:Report += [PSCustomObject]@{
        Section = $Section
        Item    = $Key
        Value   = $Value
    }
}

# ============================
# GENERAL
# ============================
Add-Row "General" "Computer Name" $CompName
Add-Row "General" "User"          $UserName
Add-Row "General" "CPU"           $CPU
Add-Row "General" "OS"            $OS.Caption
Add-Row "General" "Serial"        $BIOS.SerialNumber
Add-Row "General" "Scan Date"     (Get-Date -Format "yyyy-MM-dd HH:mm:ss")

# ============================
# RAM
# ============================
Get-CimInstance Win32_PhysicalMemory | ForEach-Object {
    Add-Row "RAM" $_.DeviceLocator "$([math]::Round($_.Capacity/1GB,2)) GB @ $($_.Speed)MHz"
}

# ============================
# DISKS
# ============================
Get-PhysicalDisk | ForEach-Object {
    Add-Row "Disks" $_.FriendlyName "$($_.MediaType) | $($_.HealthStatus) | $([math]::Round($_.Size/1GB,2)) GB"
}

# ============================
# PARTITIONS
# ============================
Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3" | ForEach-Object {
    Add-Row "Partitions" $_.DeviceID "Size: $([math]::Round($_.Size/1GB,2)) GB | Free: $([math]::Round($_.FreeSpace/1GB,2)) GB"
}

# ============================
# NETWORK
# ============================
Get-NetIPConfiguration |
Where-Object { $_.IPv4Address -and $_.InterfaceAlias -notmatch "Loopback" } |
ForEach-Object {
    $ip  = ($_.IPv4Address | Select-Object -First 1).IPAddress
    $mac = (Get-NetAdapter -Name $_.InterfaceAlias).MacAddress
    Add-Row "Network" $_.InterfaceAlias "IP: $ip | MAC: $mac"
}

# ============================
# WIFI
# ============================
try {
    $profiles = netsh wlan show profiles 2>$null |
        Select-String "\:(.*)$" |
        ForEach-Object { $_.Matches.Groups[1].Value.Trim() }

    foreach ($p in $profiles) {
        $pass = netsh wlan show profile name="$p" key=clear 2>$null |
            Select-String "Key Content\W+\:(.*)$" |
            ForEach-Object { $_.Matches.Groups[1].Value.Trim() }

        if ($pass) {
            # Mask password in CSV - store only length hint for security
            $masked = ("*" * $pass.Length)
            Add-Row "WiFi" $p $masked
        }
    }
} catch {
    Write-Log "WiFi collection skipped: $_" "Yellow"
}

# ============================
# APPS CHECK + BD VERSION
# ============================
$Apps = Get-ItemProperty `
    HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*, `
    HKLM:\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\* `
    -ErrorAction SilentlyContinue

$bdInstalled = $Apps.DisplayName -match "Bitdefender"
$bdVersion   = ($Apps | Where-Object { $_.DisplayName -match "Bitdefender" } |
                Select-Object -First 1).DisplayVersion

Add-Row "Apps" "VNC"              ($(if ($Apps.DisplayName -match "VNC") {"Installed"} else {"Not Found"}))
Add-Row "Apps" "Bitdefender"      ($(if ($bdInstalled) {"Installed"} else {"Not Found"}))
Add-Row "Apps" "Bitdefender Ver"  ($(if ($bdVersion) {$bdVersion} else {"N/A"}))
Add-Row "Apps" "Output Messenger" ($(if ($Apps.DisplayName -match "Output Messenger") {"Installed"} else {"Not Found"}))

if ($bdInstalled) {
    Write-Log "Bitdefender detected - Version: $bdVersion" "Green"
} else {
    Write-Log "Bitdefender NOT detected after installation!" "Red"
}

# ============================
# EXPORT CSV (with timestamp)
# ============================
Write-Log "Exporting CSV..." "Green"

$timestamp  = Get-Date -Format "yyyyMMdd_HHmmss"
$LocalPath  = "$env:TEMP\$CompName`_$timestamp.csv"
$FinalPath  = "$NetworkPath\$CompName`_$timestamp.csv"

$Report | Export-Csv -Path $LocalPath -NoTypeInformation -Encoding UTF8

if (Test-Path $NetworkPath) {
    Copy-Item $LocalPath $FinalPath -Force
    Write-Log "CSV saved: $FinalPath" "Green"
} else {
    Write-Log "ERROR: Could not copy CSV to network - saved locally at $LocalPath" "Red"
}

Write-Log "===== DONE: $CompName =====" "Cyan"
