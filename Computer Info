
# ============================
# Credential (no GUI)
# ============================
$credPath = "$env:APPDATA\prog_cred.xml"

if (Test-Path $credPath) {
    $cred = Import-Clixml $credPath
} else {
    Write-Host "First run - enter credentials:" -ForegroundColor Yellow
    $username = Read-Host "Username"
    $password = Read-Host "Password" -AsSecureString
    $cred = New-Object System.Management.Automation.PSCredential ($username, $password)
    $cred | Export-Clixml $credPath
}

# ============================
# CONNECT SHARE
# ============================
Write-Host "Connecting to network share..." -ForegroundColor Cyan

New-PSDrive -Name "ProgShare" -PSProvider FileSystem -Root "\\192.168.1.23\Prog" -Credential $cred | Out-Null

# ============================
# LOCAL FOLDER
# ============================
$tempDir = "C:\Bitdefender"

if (!(Test-Path $tempDir)) {
    New-Item -ItemType Directory -Path $tempDir | Out-Null
}

# ============================
# COPY WITH LIVE PROGRESS
# ============================
Write-Host "Copying files..." -ForegroundColor Yellow

$files = @("epskit_x64.exe","installer.xml")
$total = $files.Count
$i = 0

foreach ($file in $files) {

    $i++

    Copy-Item "ProgShare:\$file" "$tempDir\$file" -Force

    $percent = [int](($i / $total) * 100)

    Write-Progress `
        -Activity "Preparing Bitdefender Package" `
        -Status "Copying $file" `
        -PercentComplete $percent
}

Write-Progress -Activity "Preparing Bitdefender Package" -Completed

Remove-PSDrive ProgShare

# ============================
# INSTALL BITDEFENDER
# ============================
Write-Host "Installing Bitdefender..." -ForegroundColor Yellow

$exe = "$tempDir\epskit_x64.exe"
$xml = "$tempDir\installer.xml"

$cmd = "`"$exe`" -runInstaller -installerXml `"$xml`" -v"

$process = Start-Process "cmd.exe" `
    -ArgumentList "/c $cmd" `
    -Verb RunAs `
    -WindowStyle Hidden `
    -PassThru `
    -Wait

if ($process.ExitCode -eq 0) {
    Write-Host "Installation completed ✔" -ForegroundColor Green
} else {
    Write-Host "Installation failed (Code: $($process.ExitCode))" -ForegroundColor Red
}

Start-Sleep -Seconds 10

# ============================
# SYSTEM INFO AFTER INSTALL
# ============================
Write-Host "Collecting system data..." -ForegroundColor Cyan

$CompName = $env:COMPUTERNAME
$OSInfo = Get-CimInstance Win32_OperatingSystem
$CPU = (Get-CimInstance Win32_Processor).Name
$BIOS = Get-CimInstance Win32_BIOS

$Report = @()

function Add-Row($Section,$Key,$Value){
    $script:Report += [PSCustomObject]@{
        Section = $Section
        Item    = $Key
        Value   = $Value
    }
}

Add-Row "General" "Computer Name" $CompName
Add-Row "General" "CPU" $CPU
Add-Row "General" "OS" $OSInfo.Caption
Add-Row "General" "Serial" $BIOS.SerialNumber
Add-Row "General" "Scan Date" (Get-Date)

# RAM
Get-CimInstance Win32_PhysicalMemory | ForEach-Object {
    Add-Row "RAM" $_.DeviceLocator "$([math]::Round($_.Capacity/1GB,2)) GB"
}

# DISKS
Get-PhysicalDisk | ForEach-Object {
    Add-Row "Disks" $_.FriendlyName "$($_.MediaType) | $($_.HealthStatus)"
}

# PARTITIONS
Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3" | ForEach-Object {
    Add-Row "Partitions" $_.DeviceID "Free: $([math]::Round($_.FreeSpace/1GB,2)) GB"
}

# BITDEFENDER CHECK
$Apps = Get-ItemProperty HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*, `
                         HKLM:\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\* `
                         -ErrorAction SilentlyContinue

Add-Row "Apps" "Bitdefender" ($(if ($Apps.DisplayName -match "Bitdefender") {"Installed"} else {"Not Found"}))

# ============================
# EXPORT CSV
# ============================
Write-Host "Exporting CSV..." -ForegroundColor Green

$NetworkPath = "\\192.168.1.23\info pc"
$LocalPath = "$env:TEMP\$CompName.csv"
$FinalPath = "$NetworkPath\$CompName.csv"

$Report | Export-Csv -Path $LocalPath -NoTypeInformation -Encoding UTF8
Copy-Item $LocalPath $FinalPath -Force

# ============================
# CLEANUP
# ============================
Remove-Item $tempDir -Recurse -Force -ErrorAction SilentlyContinue

Write-Host "DONE ✔" -ForegroundColor Cyan
